rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }
    
    function isVendor() {
      return isAuthenticated() && request.auth.token.role == 'vendor';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if isOwner(vendorId) || isAdmin();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true; // Public read for catalog
      allow write: if isAdmin();
    }

    match /inventory/{productId} {
      allow read: if true; // Public read to check stock
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isOwner(resource.data.vendorId) || isAdmin();
      allow create: if isVendor() && request.resource.data.vendorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isOwner(resource.data.vendorId) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
